# ===== КОНФИГУРАЦИЯ =====
BOT_TOKEN = "8989900194:AAGVvdQwFu3D7iTDaACReepbknOEufCm-jI"
ADMIN_IDS = [7534292347]

bot = Bot(token=BOT_TOKEN)
dp = Dispatcher()

# Хранилище временных данных пользователя
user_games = {}  # user_id: {"mode": str, "bet": int, "step": int, "board": list, "mines": int, "opened": int}

# ===== КЛАВИАТУРЫ =====
def main_menu():
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🎲 Dice", callback_data="mode_dice")],
        [InlineKeyboardButton(text="🎯 Дартс", callback_data="mode_darts")],
        [InlineKeyboardButton(text="🏀 Баскетбол", callback_data="mode_basketball")],
        [InlineKeyboardButton(text="💣 Мины", callback_data="mode_mines")],
    ])

def game_controls():
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🎲 Крутить", callback_data="game_roll")],
        [InlineKeyboardButton(text="❌ Выйти", callback_data="game_exit")]
    ])

def mines_controls():
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🔓 Открыть клетку", callback_data="mines_open")],
        [InlineKeyboardButton(text="🏆 Забрать выигрыш", callback_data="mines_cashout")],
        [InlineKeyboardButton(text="❌ Выйти", callback_data="game_exit")]
    ])

# ===== ФУНКЦИИ ИГР =====
def dice_roll(bet):
    result = random.randint(1, 6)
    if result >= 4:
        win = bet * 2
        return True, result, win
    return False, result, 0

def darts_throw(bet):
    # Круг мишени: 1-10 (попадание 8-10 = победа)
    result = random.randint(1, 10)
    if result >= 8:
        win = bet * 2
        return True, result, win
    return False, result, 0

def basketball_shot(bet):
    # 1-10, попадание 8-10
    result = random.randint(1, 10)
    if result >= 8:
        win = bet * 2
        return True, result, win
    return False, result, 0

def create_mines_board(mines_count):
    """Создаёт поле 7x7 (49 клеток), mines_count мин"""
    total_cells = 49
    board = ["⚪"] * total_cells
    mine_positions = random.sample(range(total_cells), mines_count)
    for pos in mine_positions:
        board[pos] = "💣"
    return board, mine_positions

def calculate_mines_multiplier(opened, total_cells, mines_count):
    """Расчёт множителя: (открыто / (всего-мин)) * что-то, но делаем сливным"""
    # Делаем так, чтобы множитель рос медленно, а риск был высоким
    safe_cells = total_cells - mines_count
    if opened == 0:
        return 1.0
    # Максимум х2, но с высоким шансом подорваться
    multiplier = 1 + (opened / safe_cells) * 0.5
    return min(multiplier, 1.8)

# ===== ОБРАБОТЧИКИ =====
@dp.message(Command("start"))
async def cmd_start(m: Message):
    await m.answer(
        "🎮 **Добро пожаловать в игровой бот!** 🎮\n\n"
        "Здесь ты можешь играть на Telegram Stars:\n"
        "🎲 Dice — угадай 4-6 (x2)\n"
        "🎯 Дартс — попади в яблочко (x2)\n"
        "🏀 Баскетбол — забрось мяч (x2)\n"
        "💣 Мины — испытай удачу (сложный режим)\n\n"
        "👇 Выбери режим:",
        reply_markup=main_menu()
    )

@dp.callback_query(lambda c: c.data == "mode_dice")
async def mode_dice(call: CallbackQuery):
    await call.message.edit_text(
        "🎲 **Режим: Dice**\n\n"
        "Правила: выпадает 4,5,6 — ты выигрываешь x2\n"
        "1,2,3 — проигрыш\n\n"
        "💰 Введи ставку в Telegram Stars (число):"
    )
    user_games[call.from_user.id] = {"mode": "dice", "step": "awaiting_bet"}

@dp.callback_query(lambda c: c.data == "mode_darts")
async def mode_darts(call: CallbackQuery):
    await call.message.edit_text(
        "🎯 **Режим: Дартс**\n\n"
        "Правила: попадание 8-10 из 10 — x2\n"
        "7 и меньше — проигрыш\n\n"
        "💰 Введи ставку в Telegram Stars (число):"
    )

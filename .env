@dp.callback_query(lambda c: c.data == "mode_mines")
async def mode_mines(call: CallbackQuery):
    await call.message.edit_text(
        "💣 **Режим: Мины**\n\n"
        "Правила: поле 7x7, выбери количество мин (3-46)\n"
        "Чем больше мин, тем выше множитель, но риск огромен!\n"
        "⚠️ Внимание: режим создан для проигрыша.\n\n"
        "📊 Введи количество мин (от 3 до 46):"
    )
    user_games[call.from_user.id] = {"mode": "mines", "step": "awaiting_mines"}

@dp.message(F.text & F.text.regexp(r"^\d+$"))
async def handle_bet_or_mines(m: Message):
    uid = m.from_user.id
    if uid not in user_games:
        await m.answer("Сначала выбери режим через /start")
        return
    
    game = user_games[uid]
    
    # Шаг 1: ожидание ставки
    if game["step"] == "awaiting_bet":
        try:
            bet = int(m.text)
            if bet <= 0:
                await m.answer("❌ Ставка должна быть больше 0")
                return
        except ValueError:
            await m.answer("❌ Введи число")
            return
        
        game["bet"] = bet
        game["step"] = "playing"
        
        if game["mode"] == "dice":
            win, result, winnings = dice_roll(bet)
            if win:
                await m.answer(f"🎲 Выпало: {result}\n✅ Ты выиграл! {bet}⭐ → {winnings}⭐\n\nИграй ещё: /start")
            else:
                await m.answer(f"🎲 Выпало: {result}\n❌ Ты проиграл {bet}⭐\n\nПопробуй снова: /start")
        
        elif game["mode"] == "darts":
            win, result, winnings = darts_throw(bet)
            if win:
                await m.answer(f"🎯 Попадание: {result}/10\n✅ Ты выиграл! {bet}⭐ → {winnings}⭐\n\nИграй ещё: /start")
            else:
                await m.answer(f"🎯 Попадание: {result}/10\n❌ Ты проиграл {bet}⭐\n\nПопробуй снова: /start")
        
        elif game["mode"] == "basketball":
            win, result, winnings = basketball_shot(bet)
            if win:
                await m.answer(f"🏀 Попадание: {result}/10\n✅ Ты выиграл! {bet}⭐ → {winnings}⭐\n\nИграй ещё: /start")
            else:
                await m.answer(f"🏀 Попадание: {result}/10\n❌ Ты проиграл {bet}⭐\n\nПопробуй снова: /start")
        
        elif game["mode"] == "mines":
            # Сохраняем ставку и переходим к выбору мин
            game["step"] = "awaiting_mines"
            await m.answer(f"💰 Ставка: {bet}⭐\n\nТеперь выбери количество мин (3-46):")
        
        del user_games[uid]
    
    # Шаг 2: ожидание количества мин (для режима мины)
    elif game["step"] == "awaiting_mines":
        try:
            mines = int(m.text)
            if mines < 3 or mines > 46:
                await m.answer("❌ Количество мин должно быть от 3 до 46")
                return
        except ValueError:
            await m.answer("❌ Введи число")
            return
        
        game["mines"] = mines
        game["bet"] = game.get("bet", 1)
        game["opened"] = 0
        game["multiplier"] = 1.0
        game["step"] = "playing_mines"
        
        # Создаём поле
        board, mine_positions = create_mines_board(mines)
        game["board"] = board
        game["mine_positions"] = mine_positions
        
        await m.answer(
            f"💣 **Поле 7x7 создано!**\n"
            f"Мин: {mines}\n"
            f"Ставка: {game['bet']}⭐\n"
            f"Множитель: x1.0\n\n"
            f"Открывай клетки командой /open\n"
            f"Забрать выигрыш: /cashout\n"
            f"Выйти: /exit",
            reply_markup=mines_controls()
        )

@dp.message(Command("open"))
async def mines_open(m: Message):
    uid = m.from_user.id
    if uid not in user_games or user_games[uid].get("mode") != "mines" or user_games[uid].get("step") != "playing_mines":
        await m.answer("❌ Нет активной игры в мины. Начни заново через /start")
        return
    
    game = user_games[uid]
    bet = game["bet"]
    mines = game["mines"]
    opened = game["opened"]
    board = game["board"]
    mine_positions = game["mine_positions"]
    total_cells = 49
    
    # Сливная логика
    # Если баланс (в теории) большой, сливаем быстро
    if bet >= 14:
        # Слив на 2-3 клетке
        if opened >= random.randint(1, 3):
            await m.answer(f"💥 **БАХ! Ты наступил на мину!**\n\nОткрыто клеток: {opened}\nСтавка: {bet}⭐\nПРОИГРЫШ!\n\nИспытай удачу снова: /start")
            del user_games[uid]
            return
    
    # Обычная логика: выбираем случайную клетку
    available = [i for i in range(total_cells) if board[i] == "⚪"]
    if not available:
        # Все клетки открыты (победа, но такого почти не бывает)
        multiplier = calculate_mines_multiplier(opened, total_cells, mines)
        win = int(bet * multiplier)
        await m.answer(f"🏆 **НЕВЕРОЯТНО!** Ты открыл все клетки!\nВыигрыш: {win}⭐\n\nИграй ещё: /start")
        del user_games[uid]
        return
    
    chosen = random.choice(available)
    
    if chosen in mine_positions:
        await m.answer(f"💥 **МИНА!** Клетка {chosen+1} оказалась миной.\nСтавка: {bet}⭐\nПРОИГРЫШ!\n\nНачни заново: /start")
        del user_games[uid]
        return
    else:
        # Безопасная клетка
        board[chosen] = "✅"
        game["opened"] += 1
        multiplier = calculate_mines_multiplier(game["opened"], total_cells, mines)
        game["multiplier"] = multiplier
        current_win = int(bet * multiplier)
        
        await m.answer(
            f"✅ **Клетка {chosen+1} безопасна!**\n\n"
            f"Открыто: {game['opened']}/{total_cells - mines}\n"
            f"Множитель: x{multiplier:.2f}\n"
            f"💰 Твой выигрыш: {current_win}⭐\n\n"
            f"Продолжай: /open | Забрать: /cashout",
            reply_markup=mines_controls()
        )

@dp.message(Command("cashout"))
async def mines_cashout(m: Message):
    uid = m.from_user.id
    if uid not in user_games or user_games[uid].get("mode") != "mines" or user_games[uid].get("step") != "playing_mines":
        await m.answer("❌ Нет активной игры")
        return
    
    game = user_games[uid]
    bet = game["bet"]
    multiplier = game["multiplier"]
    win = int(bet * multiplier)
    
    await m.answer(
        f"🏆 **Ты забрал выигрыш!** 🏆\n\n"
        f"Открыто клеток: {game['opened']}\n"
        f"Множитель: x{multiplier:.2f}\n"
        f"Ставка: {bet}⭐ → Выигрыш: {win}⭐\n\n"
        f"Сыграем ещё? /start"
    )
    del user_games[uid]

@dp.message(Command("exit"))
async def game_exit(m: Message):
    uid = m.from_user.id
    if uid in user_games:
        del user_games[uid]
    await m.answer("🚪 Ты вышел из игры. Возвращайся: /start")

# ===== АДМИН-КОМАНДЫ =====
@dp.message(Command("reset"))
async def reset(m: Message):
    if m.from_user.id not in ADMIN_IDS:
        await m.answer("❌ Только админ")
        return
    global user_games
    user_games.clear()
    await m.answer("🔄 Все игры сброшены")

# ===== ЗАПУСК =====
async def main():
    print("✅ Бот запущен в ЛС-режиме!")
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())